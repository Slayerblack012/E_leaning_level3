{
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": [
        "server/index.js",
        "server/routes/**",
        "server/controllers/**",
        "server/models/**",
        "server/config/**",
        "server/middlewares/**",
        "server/data.json"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
